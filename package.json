{
	"type": "module",
	"scripts": {
		"build": "esbuild src/main.tsx --bundle --outfile=dist/gen/main.js --minify --format=esm",
		"dev": "pnpm build --watch --servedir=dist --sourcemap"
	},
	"devDependencies": {
		"esbuild": "^0.28.1",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.19.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.20.0",
	"dependencies": {
		"preact": "^10.29.8"
	}
}
